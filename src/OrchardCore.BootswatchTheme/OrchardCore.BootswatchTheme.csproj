<Project Sdk="Microsoft.NET.Sdk.Razor">

   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
      <Version>0.21.0</Version>
      <AssemblyName>BootswatchTheme</AssemblyName>
      <FileVersion>0.21.0</FileVersion>
      <AssemblyVersion>0.21.0</AssemblyVersion>
   </PropertyGroup>

   <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="OrchardCore.Theme.Targets" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Themes" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Admin.Abstractions" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Users.Abstractions" Version="3.0.0" />
      <PackageReference Include="OrchardCore.DisplayManagement" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Settings" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Menu" Version="3.0.0" />
      <PackageReference Include="OrchardCore.ResourceManagement" Version="3.0.0" />

      <!-- Security pin (CVE-2025-6965): OrchardCore/YesSql pull the vulnerable, deprecated
           SQLitePCLRaw 2.1.x native bundle transitively; 3.0.3 uses the patched
           SourceGear.sqlite3 (>= 3.50.4.5). Drop when upstream references a fixed bundle. -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\OrchardCore.BootswatchTheme.Settings\OrchardCore.BootswatchTheme.Settings.csproj" />
   </ItemGroup>

   <ItemGroup>
      <OrchardCoreThemes Include="BootswatchTheme" Name="Bootswatch Theme" Base="TheTheme" Description="Bootstrap-based theme with selectable Bootswatch styles" Author="Dale Newman" Version="0.17.0" Dependencies="OrchardCore.BootswatchTheme.Settings" DefaultTenant="false" AlwaysEnabled="false" EnabledByDependencyOnly="false" />
   </ItemGroup>

</Project>
