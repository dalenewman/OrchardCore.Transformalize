<Project Sdk="Microsoft.NET.Sdk.Razor">

   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
      <RootNamespace>ProxyModule</RootNamespace>
      <Version>0.21.0</Version>
      <FileVersion>0.21.0</FileVersion>
      <AssemblyVersion>0.21.0</AssemblyVersion>
      <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
      <Authors>Dale Newman</Authors>
      <Copyright>Copyright © 2023-2026</Copyright>
      <Description>for secured access to internal resources</Description>
      <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
      <PackageProjectUrl>https://github.com/dalenewman/OrchardCore.Proxy</PackageProjectUrl>
      <RepositoryUrl>https://github.com/dalenewman/OrchardCore.Proxy</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <PackageTags></PackageTags>
      <NeutralLanguage>en-US</NeutralLanguage>
      <PackageReleaseNotes>develop</PackageReleaseNotes>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
   </PropertyGroup>

   <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="OrchardCore.Alias" Version="3.0.0" />
      <PackageReference Include="OrchardCore.ContentFields" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Features" Version="3.0.0" />
      <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.0" />
      <PackageReference Include="OrchardCore.ContentManagement" Version="3.0.0" />
      <PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="3.0.0" />
      <PackageReference Include="OrchardCore.DisplayManagement" Version="3.0.0" />

      <PackageReference Include="OrchardCoreContrib.ContentPermissions" Version="1.1.0" />

      <!-- Security pin (CVE-2025-6965): OrchardCore/YesSql pull the vulnerable, deprecated
           SQLitePCLRaw 2.1.x native bundle transitively; 3.0.3 uses the patched
           SourceGear.sqlite3 (>= 3.50.4.5). Drop when upstream references a fixed bundle. -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
   </ItemGroup>

</Project>
