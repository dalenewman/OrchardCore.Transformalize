@model BulkActionViewModel
@using TransformalizeModule
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.AspNetCore.Authorization

@{
   RenderTitleSegments(Model.Task.Title, "before");
   var auth = Context.RequestServices.GetService<IAuthorizationService>();
   var editEnabled = Model.Task.ContentItem != null && await auth.AuthorizeAsync(Context.User, OrchardCore.Contents.CommonPermissions.EditContent, Model.Task.ContentItem);
   var isModal = Context.Request.Query["modal"] == "1";
   var interactivity = ViewData["FormInteractivity"] as FormInteractivityViewModel;
   var interactive = interactivity?.Interactive == true;
}

@await Html.PartialAsync("_FormResources", interactivity)

@if (isModal)
{
    <style>
        nav {
            display: none !important;
        }
        footer {
           display: none !important;
        }
    </style>
}

@if (!interactive) {
<script type="text/javascript" language="javascript">
    //<!--
      var settings = {
         location: {
            enabled: false
         },
         controller: "BulkAction",
         googlePlacesAutocomplete: @(interactivity?.HasPlaces == true ? "true" : "false"),
         ajaxUrl: "@(Url.Action("Form", "BulkAction", new { Area = Common.ModuleName, modal = Context.Request.Query["modal"] }))",
         updateUrl: "@(Url.Action("Review", "BulkAction", new { Area = Common.ModuleName, modal = Context.Request.Query["modal"] }))",
         runUrl: "@(Url.Action("Run", "BulkAction", new { Area = Common.ModuleName, modal = Context.Request.Query["modal"] }))",
         uploadUrl: "@(Url.Action("Upload", "File", new { Area = Common.ModuleName }))",
         scanUrl: "@(Url.Action("Scan", "File", new { Area = Common.ModuleName }))"
      }
   //-->
</script>
}


<div class="container">
   @if (editEnabled && !isModal) {
      <button tabindex="-1" title="edit this task" type="button" class="btn btn-warning btn-sm float-end" onclick="window.open('@(Url.Content("~/Admin/Contents/ContentItems/" + Model.Task.ContentItem.ContentItemId + "/Edit?" + Common.ReturnUrlName + "=" + System.Net.WebUtility.UrlEncode(Context.Request.Path + Context.Request.QueryString)))', '_self');">
         <span class="fas fa-edit"></span>
      </button>
   }
   <div class="row">
      <div class="col-md-4">
         <h4>Batch Summary</h4>

         @if (Model.Summary != null && Model.Summary.Entities.Any() && Model.Summary.Entities[0].Rows.Any()) {
            var fields = Model.Summary.Entities[0].GetAllOutputFields().Where(f => !Common.SystemFields.Contains(f.Alias)).ToArray();
            var row = Model.Summary.Entities[0].Rows[0];
            <table class="table table-striped table-bordered table-sm">
               <tbody>
                  @foreach (var field in fields) {
                     <tr>
                        <td>@field.Label</td>
                        <td>@(field.Raw ? Html.Raw(row[field.Alias]) : row[field.Alias])</td>
                     </tr>
                  }
               </tbody>
            </table>
         }
      </div>
      <div class="col-md-8">
         @if (Model.Task.Process.Parameters.Where(p => p.Prompt).Any()) {
            <h4>Parameters</h4>
         }
         @if (interactive) {
            @await Html.PartialAsync("_InteractiveForm", interactivity)
         } else {
            <div id="id_content">
               @await Html.PartialAsync("Form", Model.Task.Process)
            </div>
         }
      </div>
   </div>
</div>

<div id="busy_holder">
   <div id="busy"></div>
</div>
