@using Microsoft.Extensions.DependencyInjection;
@using Transformalize.Configuration
@using TransformalizeModule.ViewModels
@using TransformalizeModule.Services.Contracts
@using TransformalizeModule
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http.Extensions
@using TransformalizeModule.Ext 

@model ReportViewModel

@{

    var hasParameters = Model.Process.Parameters.Any(p => p.Prompt);
    var entity = Model.Process.Entities.FirstOrDefault() ?? new Entity { Name = "Missing Entity" };
    var entityTitle = entity.Label == string.Empty ? entity.Alias : entity.Label;
    var settings = Context.RequestServices.GetService<ISettingsService>();
    var pageSizes = new List<int>();
    if (Model.Part != null) {
        pageSizes.AddRange(settings.GetPageSizes(Model.Part));
        if(Model.Process.Mode == "map" || Model.Process.Mode == "calendar" || Model.Process.Mode == "chart") {
            if (Model.Part.PageSizesExtended.Enabled()) {
                pageSizes.AddRange(settings.GetPageSizesExtended(Model.Part));
            } else {
                pageSizes.Clear();
            }
        }
    }
    var pagingDisabled = pageSizes.Count < 2 || Model.Process.Mode != "report";
    var allFields = entity.GetAllFields().Where(f => !f.System).ToArray();
    var hasCoordinates = allFields.Any(f => f.Alias.StartsWith("lat", StringComparison.OrdinalIgnoreCase)) && allFields.Any(f => f.Alias.StartsWith("lon", StringComparison.OrdinalIgnoreCase));

    var linkService = Context.RequestServices.GetService<ILinkService>();
    var exportCsvLink = linkService.Create(Model.Item.ContentItemId, Url.Action("StreamCsv", new { ContentItemId = Model.IdOrAlias }), true);
    var exportJsonLink = linkService.Create(Model.Item.ContentItemId, Url.Action("StreamJson", new { ContentItemId = Model.IdOrAlias }), true);
    var exportGeoJsonLink = linkService.Create(Model.Item.ContentItemId, Url.Action("StreamGeoJson", new { ContentItemId = Model.IdOrAlias }), true);
    var downloadingDisabled = Model.Process.Mode != "report";
    var views = new List<PipelineViewModel>();

   var auth = Context.RequestServices.GetService<IAuthorizationService>();
   var edit =  Model.QueryValue("edit") != string.Empty;
   var isSortable = allFields.Any(f => f.Sortable == "true");

}

   @if (!Model.InteractiveReport) {
   <!-- Modal container -->
   <div class="modal fade" id="taskModal" tabindex="-1" role="dialog">
     <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
       <div class="modal-content">
         <div class="modal-body p-0">
           <iframe id="taskModalIframe"
                   name="taskModalIframe"
                   src=""
                   width="100%" height="700px"
                   frameborder="0"
                   style="border: none; display: block;"></iframe>
         </div>
       </div>
     </div>
   </div>

   }

   <div class="row">
      <div class="col-md-3">
         <div class="btn-group float-start" role="group">
            @if (entity.Name != "Missing Entity") {
               <button id="id_submit" type="submit" data-report-target="search" title="Search / Refresh" class="btn btn-primary btn-sm">
                  <span class="fas fa-search"></span>
               </button>

               <button id="id_clear" data-action="@(Model.InteractiveReport ? "click->report#clear" : null)" title="Clear the Parameters" type="button" class="btn btn-info btn-sm">Clear</button>

               if (Model.Process.Mode != "chart" && (Model.Part!.BulkActions.Value || (Model.Editable && isSortable))) {

                  <div class="btn-group btn-group-sm" role="group" aria-label="bulk actions drop down">
                     <button id="idActionDropdown" type="button" class="btn btn-sm btn-danger dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Action
                     </button>
                     <div class="dropdown-menu" aria-labelledby="idActionDropdown">
                        @if(Model.Part.BulkActions.Value){
                           foreach (var action in Model.Process.Actions.Where(a => a.Type != "open" && !string.IsNullOrEmpty(a.Name))) {
                              if (Model.InteractiveReport) {
                                 <button type="button" class="dropdown-item" data-selection-target="action"
                                         data-action="selection#submit" data-selection-name-param="@action.Name"
                                         data-selection-modal-param="@action.Modal.ToString().ToLower()" data-selection-label="@action.Description">
                                    @action.Description <span class="badge bg-secondary" data-selection-count>0</span>
                                 </button>
                              } else {
                                 <a class="bulk-action-link dropdown-item" rel="@action.Description"
                                    href="javascript:bulkAction(1, '@action.Name', @(action.Modal.ToString().ToLower()));">@action.Description</a>
                              }
                           }
                        }
                        @if(Model.Editable){
                           if(edit){
                              <a class="dropdown-item" rel="hide" href="javascript:edit('hide');">Hide</a>
                              <a class="dropdown-item" rel="search" href="javascript:edit('search');">Search</a>
                              <a class="dropdown-item" rel="facet" href="javascript:edit('facet');">Facet</a>
                              <a class="dropdown-item" rel="facets" href="javascript:edit('facets');">Facets</a>
                              <a class="dropdown-item" rel="timeago" href="javascript:edit('timeago');">Time Ago</a>
                              <a class="dropdown-item" rel="ellipsis" href="javascript:edit('ellipsis');">Ellipsis</a>
                              <a class="dropdown-item" rel="clear" href="javascript:edit('clear');">Clear</a>
                           } else {
                              <a class="dropdown-item" rel="edit" href="@(Model.InteractiveReport ? Model.NavigationUrl("edit", "1", resetPage: true) : "javascript:edit('edit');")">Edit</a>
                           }
                        }
                     </div>
                  </div>
               }
            }
         </div>

         <div class="btn-group float-start" role="group" style="padding-left: 20px;">
            @foreach (var action in Model.Process.Actions.Where(a => a.Type == "open")) {
               var url = new Flurl.Url(action.Url);
               if (!url.QueryParams.Any(qp => qp.Name == Common.ReturnUrlName)) {
                  url.SetQueryParam(Common.ReturnUrlName, Context.Request.GetEncodedUrl()); //.Replace("http:", "https:")
               }
               var modalQueryParam = url.QueryParams.Contains("modal", "1");
               if (action.Modal || modalQueryParam){
                  if(!modalQueryParam){
                     url.SetQueryParam("modal", "1");
                  }
                  <a href="@(Model.InteractiveReport ? url.ToString() : "javascript:void()")" title="@action.Description" data-url="@url" data-action="@(Model.InteractiveReport ? "click->modal#open" : null)" onclick="@(Model.InteractiveReport ? null : "loadModal(this)")" rel="nofollow" class="btn btn-sm @action.Class"><i class="fas fa-@action.Icon" aria-hidden="true">@action.Name</i></a>
               } else {
                  <a href="@url" title="@action.Description" rel="nofollow" class="btn btn-sm @action.Class"><i class="fas fa-@action.Icon" aria-hidden="true">@action.Name</i></a>
               }
            }
         </div>
      </div>

    <div class="col-md-6">
    @if (Model.Process.Mode == "chart") {
      var chartType = Context.Request.Query["chart-type"].FirstOrDefault() ?? "doughnut";
      var chartLegend = (Context.Request.Query["chart-legend"].FirstOrDefault() ?? "true") != "false";
      var chartPct = (Context.Request.Query["chart-pct"].FirstOrDefault() ?? "false") == "true";
      var isPieLike = chartType == "doughnut" || chartType == "pie";
      var chartTypeLabels = new Dictionary<string, string> {
         { "doughnut", "Doughnut" }, { "pie", "Pie" }, { "bar", "Bar" },
         { "hbar", "Horiz. Bar" }, { "line", "Line" }
      };
      var currentLabel = chartTypeLabels.GetValueOrDefault(chartType, "Doughnut");
      <div class="d-flex justify-content-center gap-2 align-items-center flex-wrap">
         <small class="text-muted fw-semibold" style="white-space:nowrap;">
            @Model.Title
            @if (entity.Hits > 0) {
               <span class="fw-normal">&middot; @entity.Hits.ToString("#,##0")</span>
            }
         </small>
         <div class="btn-group btn-group-sm" role="group">
            <button class="btn btn-sm btn-outline-secondary" disabled style="min-width:80px;">@currentLabel</button>
            <button class="btn dropdown-toggle btn-sm btn-outline-secondary" data-bs-toggle="dropdown" aria-expanded="false" title="chart style">
               <span class="caret"></span>
            </button>
            <div class="dropdown-menu">
               @foreach (var kv in chartTypeLabels) {
                  <a class="dropdown-item @(kv.Key == chartType ? "active" : string.Empty)"
                     href="javascript:setChartType('@kv.Key');">@kv.Value</a>
               }
            </div>
         </div>
         <button class="btn btn-sm @(chartLegend ? "btn-secondary" : "btn-outline-secondary")"
                 onclick="toggleChartLegend();" title="Toggle legend">Legend</button>
         @if (isPieLike) {
            <button class="btn btn-sm @(chartPct ? "btn-secondary" : "btn-outline-secondary")"
                    onclick="toggleChartPct();" title="Show percentages">%</button>
         }
      </div>
   } else if (entity.Page == 0 || Model.Process.Mode == "map" && !Model.Part.PageSizesExtended.Enabled() || Model.Process.Mode == "calendar" && !Model.Part.PageSizesExtended.Enabled()) {
        <h3 class="text-primary" style="margin: 2px 0px 0px 0px;">@(entity.Label == string.Empty ? entity.Alias : entity.Label)</h3>
    } else {
         @await Html.PartialAsync("_ReportPagination", Model)
         }
   </div>


      <div class="col-md-3">
         <div class="btn-group float-end" role="group">

            @if (entity.Name != "Missing Entity") {

               if (Model.Item != null && await auth.AuthorizeAsync(Context.User, OrchardCore.Contents.CommonPermissions.EditContent, Model.Item)) {
                  if (Model.BreadCrumbs.Any()){
                     if (!string.IsNullOrEmpty(Context.Request.Query["t"].ToString())){
                        var currentUrl = Context.Request.GetEncodedUrl();
                        var saveUrl = new Flurl.Url(currentUrl).SetQueryParam("save", "true");
                        <a title="save and edit this" class="btn btn-warning btn-sm" href="@saveUrl">
                           <span class="fas fa-edit"></span>
                        </a>
                     }
                  } else {
                     <a title="edit this report" class="btn btn-warning btn-sm" href="@(Url.Content("~/Admin/Contents/ContentItems/" + Model.Item.ContentItemId + "/Edit?" + Common.ReturnUrlName + "=" + System.Net.WebUtility.UrlEncode(Context.Request.Path + Context.Request.QueryString)))">
                        <span class="fas fa-edit"></span>
                     </a>
                  }
               }

               @*if (Model.Process.Mode == "map") {
                   if (Model.MapCfg != null) {
                       <div class="btn-group" role="group">
                           <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                               Style
                               <span class="caret"></span>
                           </button>
                           <ul class="dropdown-menu" id="mapStyles">
                               @foreach (var style in Model.MapCfg.Styles) {
                                   <li style="cursor: pointer;"><a id="@style.Url">@style.Name</a></li>
                               }
                           </ul>
                       </div>
                   }
                   if (Model.Part.MapRefresh) {
                       <button title="refresh map" type="button" class="btn btn-danger btn-sm" id="mapRefresh">
                           <span class="fas fa-refresh"></span>
                       </button>
                   }
               }*@

               // for now, if map is not enabled, you don't need this because there is only map and report views so far (no calendar)
               var hasFacetMaps = Model.Process.Maps.Any(m => m.Name.StartsWith("map-", StringComparison.OrdinalIgnoreCase));
               if (Model.Part.Map.Value && hasCoordinates || Model.Part.Calendar.Value ||  (hasFacetMaps && !Model.BreadCrumbs.Any())) {

                  var headless = Context.Request.GetDisplayUrl().Contains("Headless");

                  // not using Url.Action because I don't want the autoroute (friendly slug name) here
                  var reportUrl = Url.Content("~/t/report/" + Model.IdOrAlias);
                  if (headless) {
                     reportUrl = reportUrl.Replace("/t/report/", "/t/headless/report/");
                  }

                  views.Add(new PipelineViewModel("report") {
                     Active = Model.Process.Mode == "report",
                     Glyphicon = "list",
                     Link = linkService.Create(Model.IdOrAlias, reportUrl, !Model.Part.PageSizes.Enabled())
                  });

                  if (Model.Part.Map.Value && hasCoordinates) {

                     var mapUrl = Url.Action("Index", "Map", new { ContentItemId = Model.IdOrAlias });
                     if (headless) {
                        mapUrl = mapUrl.Replace("/t/report/map/", "/t/headless/report/map/");
                     }
                     views.Add(new PipelineViewModel("map") {
                        Active = Model.Process.Mode == "map",
                        Glyphicon = "map-marker",
                        Link = linkService.Create(Model.IdOrAlias, mapUrl, !Model.Part.PageSizesExtended.Enabled())
                     });
                  }

                  if (Model.Part.Calendar.Value) {

                     var calendarUrl = Url.Action("Index", "Calendar", new { ContentItemId = Model.IdOrAlias });
                     if (headless) {
                        calendarUrl = calendarUrl.Replace("/t/report/calendar/", "/t/headless/report/calendar/");
                     }
                     views.Add(new PipelineViewModel("calendar") {
                        Active = Model.Process.Mode == "calendar",
                        Glyphicon = "calendar",
                        Link = linkService.Create(Model.IdOrAlias, calendarUrl, !Model.Part.PageSizesExtended.Enabled())
                     });
                  }

                  if (hasFacetMaps && !Model.BreadCrumbs.Any()) {

                     var chartUrl = Url.Action("Index", "Chart", new { ContentItemId = Model.IdOrAlias });
                     views.Add(new PipelineViewModel("chart") {
                        Active = Model.Process.Mode == "chart",
                        Glyphicon = "poll",
                        Link = linkService.Create(Model.IdOrAlias, chartUrl, true)
                     });
                  }

                  var defaultView = views.First(v => v.Mode != Model.Process.Mode);

                  <div class="btn-group btn-group-sm" role="group">
                     <a class="btn btn-primary btn-sm" title="@defaultView.Title" href="@defaultView.Link">
                        <span class="fas fa-@defaultView.Glyphicon"></span>
                     </a>
                     <button type="button" class="btn btn-primary btn-sm dropdown-toggle" title="other views" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="caret"></span>
                     </button>
                     <div class="dropdown-menu">
                        @foreach (var export in views) {
                           <a class="dropdown-item @(export.Active ? "active" : string.Empty)" href="@(export.Link)" title="@export.Title">
                              <span class="fas fa-@export.Glyphicon"></span>&nbsp;&nbsp;@export.Label
                           </a>
                        }
                     </div>
                  </div>
               }

               @await Html.PartialAsync("_ReportExports", new ReportExportsViewModel {
                  Interactive = Model.InteractiveReport, Disabled = downloadingDisabled,
                  CsvUrl = exportCsvLink.ToString(), JsonUrl = exportJsonLink.ToString(), GeoJsonUrl = hasCoordinates ? exportGeoJsonLink.ToString() : null,
                  TableId = $"id_table_{entity.Sequence}"
               })

                  <div class="btn-group btn-group-sm">
                     <button class="btn btn-sm btn-outline-info" disabled="disabled">Size</button>
                     <button class="btn dropdown-toggle btn-sm btn-outline-info" data-bs-toggle="dropdown" title="set page size" style="padding-left:4px;" disabled="@pagingDisabled">
                        <span class="caret"></span>
                     </button>
                     <div class="dropdown-menu" disabled="@pagingDisabled">
                        @foreach (var size in pageSizes) {
                           <a class="dropdown-item @(entity.Size.Equals(size) ? "active" : string.Empty)" href="@(Model.InteractiveReport ? Model.NavigationUrl("size", size.ToString(), resetPage: true) : $"javascript:controls.setSize({size});")" data-action="@(Model.InteractiveReport ? "click->report#resize" : null)" data-report-size-param="@size" disabled="@pagingDisabled">@size</a>
                        }
                     </div>
                  </div>

            }
         </div>
      </div>
   </div>
