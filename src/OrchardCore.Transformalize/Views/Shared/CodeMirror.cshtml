@model CodeMirrorViewModel
@using TransformalizeModule

<script asp-name="codemirror6" version="@Common.CodeMirrorVersion" depends-on="admin" at="Foot"></script>

<script at="Foot">
    (function () {
        var textAreaId = '@Model.TextAreaId';
        var portion = @Model.Portion;
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                if (window.TransformalizeCodeMirror) {
                    window.TransformalizeCodeMirror.init(textAreaId, portion);
                }
            });
        } else {
            if (window.TransformalizeCodeMirror) {
                window.TransformalizeCodeMirror.init(textAreaId, portion);
            }
        }
    }());
</script>
