<div class="tfl-location mb-2 text-end">
   <button id="id_location_button" type="button" tabindex="-1" class="btn btn-success btn-sm"
           title="Query location" aria-label="Query location"
           data-tfl-location-target="button" data-action="tfl-location#locate">
      <span class="fas fa-location-arrow" data-tfl-location-target="icon" aria-hidden="true"></span>
      <span class="spinner-border spinner-border-sm" data-tfl-location-target="spinner" aria-hidden="true" hidden></span>
   </button>
   <span class="small" role="status" data-tfl-location-target="status"></span>
</div>
